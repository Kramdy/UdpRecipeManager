<Window x:Class="RecipeClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UDP Recipe Client" Height="600" Width="650"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="Server:" VerticalAlignment="Center"/><TextBox x:Name="IpBox" Text="127.0.0.1" Width="110" Margin="8,0"/><TextBox x:Name="PortBox" Text="5000" Width="60"/><Button Content="Connect" Click="Connect_Click" Margin="8,0"/></StackPanel><StackPanel DockPanel.Dock="Top" Margin="0,10"><TextBox x:Name="IngredientsBox" Text="chicken, salad"/><Button x:Name="SearchButton" Content="Find recipe" Click="Search_Click" Margin="0,8,0,0"/></StackPanel><Image x:Name="DishImage" Height="270" Stretch="Uniform" Margin="0,10"/><TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,6"/><TextBlock x:Name="InstructionsText" TextWrapping="Wrap"/></DockPanel></Window>
